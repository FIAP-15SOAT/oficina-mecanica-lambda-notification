NODE_ENV=development
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
OTEL_SERVICE_NAME=oficina-mecanica-lambda-notification
OTEL_SERVICE_NAMESPACE=oficina-mecanica
SERVICE_VERSION=dev
# OTEL_EXPORTER_OTLP_ENDPOINT: OTLP/HTTP span receiver (the telemetry extension at http://localhost:4318 on AWS); empty or absent turns span export off
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Oficina Mecânica <noreply@oficina.local>"
